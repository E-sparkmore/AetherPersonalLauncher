<UserControl x:Class="AetherPersonalLauncher.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AetherPersonalLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="700">
    <UserControl.DataContext>
        <local:DownloadPageViewModel x:Name="ViewModel" />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#44000000">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5"
                        Style="{StaticResource SideStackPanel}">
                <RadioButton Content="正式版"
                             Style="{StaticResource PageTabButton}"
                             Width="150" Height="40"
                             Margin="5 5"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             IsChecked="True"
                             Command="{Binding ReleaseBtnClicked}" />
                <RadioButton Content="快照"
                             Style="{StaticResource PageTabButton}"
                             Width="150" Height="40"
                             Margin="5 5"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             Command="{Binding SnapshotBtnClicked}" />
                <RadioButton Content="Beta版"
                             Style="{StaticResource PageTabButton}"
                             Width="150" Height="40"
                             Margin="5 5"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             Command="{Binding OldBetaBtnClicked}" />
                <RadioButton Content="Alpha版"
                             Style="{StaticResource PageTabButton}"
                             Width="150" Height="40"
                             Margin="5 5"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             Command="{Binding OldAlphaBtnClicked}" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Visibility="{Binding ProgressBarVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="加载中..." VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       FontFamily="{StaticResource UniFont}" FontSize="18" Margin="20">
            </TextBlock>
            <ProgressBar Grid.Row="1" VerticalAlignment="Top"
                         HorizontalAlignment="Stretch" 
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Height="20" Margin="30" Maximum="1" Minimum="0"
                         Value="{Binding Progress}"
                         BorderBrush="#2F2F2F" BorderThickness="4" Foreground="#2F2F2F" />
        </Grid>
        <ListBox Grid.Column="1" ItemsSource="{Binding Current}"
                 BorderThickness="0" HorizontalContentAlignment="Stretch"
                 Visibility="{Binding VersionListVisibility}"
                 x:Name="VersionInfos" Background="#2F2F2F">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Margin="10 5" Padding="20 6"
                            CornerRadius="5" x:Name="ItemBorder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Foreground="White"
                                       FontFamily="{StaticResource UniFont}">
                                <Run Text="{Binding Id}" FontSize="15"></Run><LineBreak />
                                <Run Text="{Binding ReleaseTime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontSize="10"></Run>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Content="下载"
                                    Style="{StaticResource MineCraftButton}"
                                    Width="100"
                                    CommandParameter="{Binding}"
                                    Command="{Binding ElementName=ViewModel, Path=DownloadClicked}"
                                    IsEnabled="{Binding ElementName=ViewModel, Path=IsDownloadEnable}">
                            </Button>
                        </Grid>
                        <Border.RenderTransform>
                            <TranslateTransform X="100" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                                     Duration="0:0:0.5"
                                                     From="100"
                                                     To="0">
                                        <DoubleAnimation.EasingFunction>
                                            <PowerEase EasingMode="EaseOut" Power="4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     Duration="0:0:0.5"
                                                     From="0"
                                                     To="1">
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>