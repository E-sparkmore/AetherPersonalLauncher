<Window x:Class="AetherPersonalLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AetherPersonalLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             Duration="0:0:0.5"
                                             From="0"
                                             To="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="0"
                            CornerRadius="10" 
                            ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="40" Background="#44000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Aether的个人启动器" 
                       VerticalAlignment="Center" 
                       Margin="10 0 0 0"
                       FontFamily="{StaticResource UniFont}"
                       FontSize="18"
                       FontWeight="Bold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                        VerticalAlignment="Center" Height="40"
                        HorizontalAlignment="Center">
                <RadioButton Content="首    页" 
                             Style="{StaticResource PageTabButton}" 
                             Width="150" Height="30"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Margin="5 0"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             IsChecked="True" Checked="HomePageOpen"/>
                <RadioButton Content="下    载" 
                             Style="{StaticResource PageTabButton}" 
                             Width="150" Height="30"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Margin="5 0"
                             FontSize="14" FontFamily="{StaticResource UniFont}"
                             Checked="DownloadPageOpen"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="40">
                <Button Style="{StaticResource ControlButton}" 
                        Content="🗕"
                        Click="MinimizeAction" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Height="40" Width="40"/>
                <Button Style="{StaticResource ControlButton}" 
                        Content="🗙"
                        Click="CloseAction"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="40" Height="40"/>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="ClientArea"></ContentControl>
    </DockPanel>
</Window>