<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageTabButton" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="0"
                            BorderBrush="White"
                            Background="#6F6F6F"
                            Padding="{TemplateBinding RadioButton.Padding}"
                            Margin="{TemplateBinding RadioButton.Margin}"
                            x:Name="PageTabBtnBorder">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5"
                                              Direction="315"
                                              ShadowDepth="1"
                                              Color="Black" />
                        </Border.Effect>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="{TemplateBinding RadioButton.Content}"
                                   Foreground="White"
                                   FontSize="{TemplateBinding RadioButton.FontSize}"
                                   FontFamily="{TemplateBinding RadioButton.FontFamily}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Click">
                            <SoundPlayerAction Source="pack://application:,,,/Assets/Sounds/ButtonClick.wav" />
                        </EventTrigger>
                        <Trigger Property="RadioButton.IsMouseOver" Value="True">
                            <Setter TargetName="PageTabBtnBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="RadioButton.IsChecked" Value="True">
                            <Setter TargetName="PageTabBtnBorder"
                                    Property="Background"
                                    Value="#2F2F2F">
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="ControlButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                            CornerRadius="2" Background="Transparent" x:Name="ControlButtonBorder">
                        <TextBlock Text="{TemplateBinding Button.Content}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ControlButtonBorder"
                                    Property="Background"
                                    Value="#88888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MineCraftButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="0"
                            BorderBrush="White"
                            Background="#6F6F6F"
                            Padding="{TemplateBinding Button.Padding}"
                            x:Name="PageTabBtnBorder">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5"
                                              Direction="315"
                                              ShadowDepth="1"
                                              Color="Black" />
                        </Border.Effect>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="{TemplateBinding Button.Content}"
                                   Foreground="White"
                                   FontSize="{TemplateBinding Button.FontSize}"
                                   FontFamily="{TemplateBinding Button.FontFamily}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Click">
                            <SoundPlayerAction Source="pack://application:,,,/Assets/Sounds/ButtonClick.wav" />
                        </EventTrigger>
                        <Trigger Property="Button.IsMouseOver" Value="True">
                            <Setter TargetName="PageTabBtnBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="Button.IsEnabled" Value="False">
                            <Setter TargetName="PageTabBtnBorder"
                                    Property="Background"
                                    Value="#2F2F2F">
                            </Setter>
                        </Trigger>
                        <Trigger Property="Button.IsPressed" Value="True">
                            <Setter TargetName="PageTabBtnBorder"
                                    Property="Background"
                                    Value="#2F2F2F">
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>