<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SideStackPanel" TargetType="StackPanel">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-50" Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="StackPanel.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         Duration="0:0:0.6"
                                         From="0"
                                         To="1" />
                        <DoubleAnimation
                            Storyboard.TargetProperty="(StackPanel.RenderTransform).(TranslateTransform.X)"
                            Duration="0:0:0.6"
                            From="-50"
                            To="0"
                            DecelerationRatio="0.6">
                            <DoubleAnimation.EasingFunction>
                                <PowerEase EasingMode="EaseOut" Power="4"></PowerEase>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SideGrid" TargetType="Grid">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-50" Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         Duration="0:0:0.6"
                                         From="0"
                                         To="1" />
                        <DoubleAnimation
                            Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.X)"
                            Duration="0:0:0.6"
                            From="-50"
                            To="0"
                            DecelerationRatio="0.6">
                            <DoubleAnimation.EasingFunction>
                                <PowerEase EasingMode="EaseOut" Power="4"></PowerEase>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>