<Application x:Class="AetherPersonalLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AetherPersonalLauncher"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <ResourceDictionary Source="Assets/Fonts/Fonts.xaml"/>
                 <ResourceDictionary Source="Assets/Styles/ButtonStyle.xaml"/>
                 <ResourceDictionary Source="Assets/Styles/SideBarStyle.xaml"/>
             </ResourceDictionary.MergedDictionaries>
         </ResourceDictionary>
    </Application.Resources>
</Application>
